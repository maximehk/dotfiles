#!/bin/sh

sudo apt update

# Core utilities and development tools
sudo apt install -y \
       btop \
       bzip2 \
       curl \
       detox \
       fastfetch \
       fd-find \
       fish \
       fzf \
       gh \
       git \
       git-delta \
       glow \
       golang-go \
       htop \
       jq \
       just \
       moreutils \
       ncdu \
       neovim \
       nmap \
       python3 \
       rustup \
       tcpdump \
       tcpreplay \
       tmux \
       tree \
       unzip \
       zip \
       zoxide

mkdir -p ~/.local/bin

# Initialize rustup (installs stable toolchain)
rustup default stable
export PATH="$HOME/.cargo/bin:$HOME/.local/bin:$PATH"
cargo install cargo-binstall
# -y: no confirmation question, so this also works without a keyboard (first boot of a server)
cargo binstall -y zellij
# tlrc: the tldr client (Ubuntu has no "tldr" package)
cargo binstall -y tlrc
mkdir -p ~/.config/fish/completions
zellij setup --generate-completion fish > ~/.config/fish/completions/zellij.fish

# Install uv (Python package manager)
curl -LsSf https://astral.sh/uv/install.sh | sh

# Install scc (source code counter); keep Go out of ~/go
export GOPATH="$HOME/.local/share/go" GOBIN="$HOME/.local/bin"
go install github.com/boyter/scc/v3@latest

# Install starship prompt
command -v starship >/dev/null || curl -sS https://starship.rs/install.sh | sh -s -- -y
